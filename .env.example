# Safe example values only. Never place a real key in source control.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TRANSLATION_MODEL=mimo-v2.5
MIMO_SUMMARY_MODEL=mimo-v2.5-pro
MIMO_ASR_LANGUAGE=en

# V1 must bind to loopback only.
APP_HOST=127.0.0.1
APP_PORT=8000

# Runtime path is intentionally outside the Git checkout in production.
# CLASSROOM_INTERPRETER_DATA_DIR=

# Segmentation values are Phase 2 calibration inputs, not frozen SLAs.
SEGMENT_MIN_SECONDS=2
SEGMENT_PREFERRED_SECONDS=12
SEGMENT_MAX_SECONDS=30
SEGMENT_SILENCE_MILLISECONDS=700
SEGMENT_OVERLAP_MILLISECONDS=250

# Translation context remains bounded.
CONTEXT_MAX_SEGMENTS=8
CONTEXT_MAX_SECONDS=90

# Classroom content logging is off by default.
DEBUG_CLASSROOM_CONTENT=false
