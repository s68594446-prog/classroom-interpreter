# Safe example values only. Never place a real key in source control.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TRANSLATION_MODEL=mimo-v2.5
MIMO_SUMMARY_MODEL=mimo-v2.5-pro
MIMO_ASR_LANGUAGE=en

# V1 must bind to loopback only.
APP_HOST=127.0.0.1
APP_PORT=8000

# Runtime path is intentionally outside the Git checkout in production.
# CLASSROOM_INTERPRETER_DATA_DIR=

# Segmentation values are Phase 2 calibration inputs, not frozen SLAs.
SEGMENT_MIN_SECONDS=2
SEGMENT_PREFERRED_SECONDS=6
SEGMENT_MAX_SECONDS=30
SEGMENT_SILENCE_MILLISECONDS=700
SEGMENT_OVERLAP_MILLISECONDS=250

# Auto-pause recording after this many seconds of continuous silence
# (class over, break, microphone left on). 0 disables it. Must be longer
# than SEGMENT_SILENCE_MILLISECONDS or ordinary sentence gaps would pause
# the class mid-lecture.
AUTO_PAUSE_SILENCE_SECONDS=30

# Interim ("partial") transcription of the sentence still being spoken. This is
# what makes a caption appear ~2s after speech instead of ~7s. It costs roughly
# one extra ASR call per interval per utterance, so it is a latency/cost dial.
# 0 disables it; the sealed-segment pipeline is unaffected either way.
PARTIAL_TRANSCRIPTION_INTERVAL_SECONDS=2.0
PARTIAL_TRANSCRIPTION_MIN_AUDIO_MS=2500

# Translation context remains bounded.
CONTEXT_MAX_SEGMENTS=8
CONTEXT_MAX_SECONDS=90

# Classroom content logging is off by default.
DEBUG_CLASSROOM_CONTENT=false
